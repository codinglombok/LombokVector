{
    "name": "codinglombok/lombokvector",
    "description": "SIMD-style vector math for RAG systems — cosine similarity, dot product, L2 distance. Zero dependencies.",
    "type": "library",
    "license": "Apache-2.0",
    "version": "0.1.0",
    "authors": [
        { "name": "codinglombok" }
    ],
    "autoload": {
        "psr-4": {
            "CodingLombok\\LombokVector\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "autoload-dev": {
        "psr-4": {
            "CodingLombok\\LombokVector\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
